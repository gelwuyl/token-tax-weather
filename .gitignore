# The engine writes the API declarations into the mod's own folder as it loads
# it. They are this build's, not this plugin's, and must never be committed.
**/.claude-plugin/types/
node_modules/

# `plugin test` compiles each .ts beside it. Those siblings are build output,
# rewritten on every run, and never the source of truth.
token-tax-weather/hooks/*.js
token-tax-weather/tests/*.js
